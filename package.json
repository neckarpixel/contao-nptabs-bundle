{
    "name": "contao-nptabs-bundle",
    "private": true,
    "description": "Build-Skripte für das Standard-CSS (SCSS -> public/tabs.css)",
    "scripts": {
        "build": "sass --no-source-map --style=compressed assets/scss/build.scss public/tabs.css",
        "watch": "sass --watch --no-source-map assets/scss/build.scss public/tabs.css"
    },
    "devDependencies": {
        "sass": "^1.80.0"
    }
}
